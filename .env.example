# ---------------------------------------------------------------------------
# Read-Only Money Coach environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Sandbox REST app credentials from developer.paypal.com > Apps & Credentials.
# Create a NEW sandbox app with only Transaction Search / balance reporting
# enabled. Do not enable payment, checkout, payout, refund, or invoicing features.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# OpenAI API key used only by the server-side AI route.
OPENAI_API_KEY=sk-your-openai-api-key
